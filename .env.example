# Conexión a PostgreSQL
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/votape?schema=public"

# Secreto para firmar las cookies de sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# "Pimienta" usada para hashear los tokens de acceso. NO cambiarla después de
# generar los tokens: todos los tokens emitidos dejarían de ser válidos.
TOKEN_PEPPER=""

# Contraseña del panel /admin
ADMIN_PASSWORD=""
