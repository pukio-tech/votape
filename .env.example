# Conexión a PostgreSQL
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/votape?schema=public"

# Secreto para firmar las cookies de sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# "Pimienta" usada para hashear los tokens de acceso. NO cambiarla después de
# generar los tokens: todos los tokens emitidos dejarían de ser válidos.
TOKEN_PEPPER=""

# Administrador inicial del panel /admin. Se crea automáticamente en el primer
# ingreso (o con npm run db:seed / npm run admin:crear) si aún no hay usuarios.
# Luego se pueden registrar más usuarios del comité desde /admin/usuarios.
ADMIN_EMAIL="admin@admin.com"
ADMIN_PASSWORD=""

# Almacenamiento S3 compatible (fotos de candidatos)
AWS_ENDPOINT_URL_S3=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
AWS_S3_BUCKET="votape"
